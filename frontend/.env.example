# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
# cp .env.example .env

# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# 백엔드(ando-BE) 서버 주소. 실기기 테스트 시 PC와 같은 네트워크의 사설 IP.
# 예: http://192.168.0.10:5000  (에뮬레이터는 http://10.0.2.2:5000)
EXPO_PUBLIC_ROUTE_API_URL=

# Supabase 프로젝트 설정 > API 에서 확인
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
