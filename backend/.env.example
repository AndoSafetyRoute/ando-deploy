# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
# cp .env.example .env

# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키
KAKAO_REST_API_KEY=
KAKAO_JS_API_KEY=

# 경사도 그래프 데이터 경로 — README의 "데이터 파일" 절 참고 (레포에 포함 안 됨,
# 용량 커서 별도로 받아야 함). 서울 전역: data/road_10m_slope_seoul.geojson
# (용산구만 필요하면 더 작은 data/road_5m_slope.geojson 로 대체 가능)
GEOJSON_PATH=data/road_10m_slope_seoul.geojson

# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성으로 받은 JSON을
# 이 경로에 저장 (레포에 커밋 금지)
FIREBASE_KEY_PATH=firebase-key.json

# Supabase 프로젝트 설정 > Database > Connection string (URI) 에서 확인
# 형식: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# ── 서울 열린데이터광장(data.seoul.go.kr) API 키 ──────────────────────────────
# 아래 서비스들을 각각 신청하면 발급되는 인증키. 서비스명 기준:
# OA-22740  교통약자이용정보 엘리베이터 현황   서비스명: getWksnElvtr
SEOUL_ELEVATOR_KEY=
# OA-22742  교통약자이용정보 에스컬레이터 현황  서비스명: getWksnEsctr
SEOUL_ESCALATOR_KEY=
# OA-22728  편의시설위치정보 에스컬레이터 현황  서비스명: getFcEsctr (위와 동일 데이터, 폴백용)
SEOUL_ESC_FACILITY_KEY=
# OA-15994  승강기 가동현황 → 서비스 종료(2025), 코드상 미사용이지만 키 존재는 확인
SEOUL_LIFT_STATUS_KEY=
# OA-22745  휠체어 급속충전기 위치정보   서비스명: getWksnWhclCharge
SEOUL_CHARGER_KEY=

# 서울 지하철 실시간 도착(swopenapi.seoul.go.kr) — /subway/arrival (대중교통 탭 지하철 배지).
# 비우면 배지만 안 뜨고 서버는 정상 동작.
SEOUL_REALTIME_KEY=

# ── 서울 버스 실시간 도착 + 저상버스 (공공데이터포털, ws.bus.go.kr) ─────────
# /bus/arrival (대중교통 탭 버스 배지). BUS_ARRIVAL_KEY = 버스도착정보조회 서비스,
# BUS_ROUTE_INFO_KEY = 노선정보조회 서비스(계정이 다르면 키가 다름 — 같으면 비워도 됨),
# BUS_ROUTE_INFO_ENABLED=1 이어야 노선번호→노선ID 조회를 한다. 비우면 배지만 안 뜸.
BUS_ARRIVAL_KEY=
BUS_ROUTE_INFO_KEY=
BUS_ROUTE_INFO_ENABLED=

# ── 지하철 CSV 데이터 경로 ────────────────────────────────────────────────────
# 서울교통공사 엘리베이터/에스컬레이터/휠체어리프트 설치정보 CSV가 있는 디렉토리.
# 비워두면 backend/subway_data/ (레포에 포함) 를 쓴다.
SUBWAY_DATA_DIR=

# ── 저상버스 노선별 보유율 (OA-22229, REST API 없음 — 파일 다운로드 방식) ────
# 비워두면 backend/data/저상버스_노선별_보유율.xlsx(레포에 포함됨)를 쓴다.
# 없어도 저상버스 정보 없이 동작(폴백)하므로 필수는 아님.
LOWFLOOR_BUS_XLSX=

# v3부터 PathFinder/ODsay 관련 키는 쓰지 않습니다 — 대중교통 경로탐색은 프론트가
# 카카오 API로 직접 조회합니다(관련 키 발급 불필요).
