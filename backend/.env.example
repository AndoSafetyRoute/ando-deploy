# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
# cp .env.example .env

# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키
KAKAO_REST_API_KEY=
KAKAO_JS_API_KEY=

# 경사도 그래프 데이터 경로 — README의 "데이터 파일" 절 참고 (레포에 포함 안 됨,
# 용량 커서 별도로 받아야 함). 서울 전역: data/road_10m_slope_seoul.geojson
# (용산구만 필요하면 더 작은 data/road_5m_slope.geojson 로 대체 가능)
GEOJSON_PATH=data/road_10m_slope_seoul.geojson

# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성으로 받은 JSON을
# 이 경로에 저장 (레포에 커밋 금지)
FIREBASE_KEY_PATH=firebase-key.json

# Supabase 프로젝트 설정 > Database > Connection string (URI) 에서 확인
# 형식: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# ── 서울 열린데이터광장(data.seoul.go.kr) API 키 ──────────────────────────────
# 아래 서비스들을 각각 신청하면 발급되는 인증키. 서비스명 기준:
# OA-22740  교통약자이용정보 엘리베이터 현황   서비스명: getWksnElvtr
SEOUL_ELEVATOR_KEY=
# OA-22742  교통약자이용정보 에스컬레이터 현황  서비스명: getWksnEsctr
SEOUL_ESCALATOR_KEY=
# OA-22728  편의시설위치정보 에스컬레이터 현황  서비스명: getFcEsctr (위와 동일 데이터, 폴백용)
SEOUL_ESC_FACILITY_KEY=
# OA-15994  승강기 가동현황 → 서비스 종료(2025), 코드상 미사용이지만 키 존재는 확인
SEOUL_LIFT_STATUS_KEY=
# OA-22745  휠체어 급속충전기 위치정보   서비스명: getWksnWhclCharge
SEOUL_CHARGER_KEY=

# 서울 지하철 실시간 도착(swopenapi.seoul.go.kr) — 현재 연동 코드 없음(미사용),
# 추후 기능 추가 대비 키만 준비. 비워둬도 서버 실행에는 지장 없음.
SEOUL_REALTIME_KEY=
